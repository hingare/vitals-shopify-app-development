# ওয়েবসাইটের সেটিংস। এই ফাইল কপি করে .env.local নামে রাখুন। আসল মান কখনো GitHub-এ দেবেন না।
# সাইটের পেজগুলো বিল্ডের সময় তৈরি হয়, তাই NEXT_PUBLIC_*, ভেরিফিকেশন কোড আর ANTHROPIC_API_KEY
# বিল্ডের সময়েই থাকতে হবে। বদলালে আবার বিল্ড করুন।

# সাইটের আসল ঠিকানা (শেষে / ছাড়া)। canonical, sitemap, hreflang আর llms.txt-এর লিংক এখান থেকে হয়।
# ফাঁকা রাখলে packages/brand-এর website ব্যবহার হয়। লোকালে: http://localhost:3100
NEXT_PUBLIC_SITE_URL=""

# ---- PostHog (ভিজিটরের পরিসংখ্যান) ----
# ফাঁকা রাখলে কোনো analytics লোড হয় না। কুকি রাখে না, সেশন রেকর্ড করে না, Do Not Track মানে।
NEXT_PUBLIC_POSTHOG_KEY=""
# EU-তে ডেটা রাখতে চাইলে https://eu.i.posthog.com (ফাঁকা থাকলে US)
NEXT_PUBLIC_POSTHOG_HOST=""

# ---- সার্চ ইঞ্জিন ভেরিফিকেশন ----
# Google Search Console > HTML tag পদ্ধতির content="..." অংশটা
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools > HTML Meta Tag পদ্ধতির content="..." অংশটা
BING_SITE_VERIFICATION=""

# ---- সাইটের AI সাপোর্ট চ্যাট ----
# চাবি console.anthropic.com থেকে। ফাঁকা রাখলে চ্যাট বাটন দেখায় না, হেল্প পেজে শুধু ইমেইল দেখায়।
ANTHROPIC_API_KEY=""
# "off" দিলে চাবি থাকলেও চ্যাট বন্ধ থাকে
SUPPORT_CHAT=""
# সব ভিজিটর মিলে দিনে সর্বোচ্চ কতগুলো প্রশ্ন (খরচ বাঁধার জন্য)। ফাঁকা থাকলে ৩০০।
SUPPORT_CHAT_DAILY_LIMIT=""
# ঐচ্ছিক: কোন মডেল উত্তর দেবে। ফাঁকা থাকলে claude-haiku-5-5।
SUPPORT_CHAT_MODEL=""
