# এই ফাইল কপি করে .env নামে রাখুন। আসল মান কখনো GitHub-এ দেবেন না।
DATABASE_URL="postgresql://app:app@localhost:5434/allinone?schema=public"
REDIS_URL="redis://localhost:6380"
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET `shopify app dev` নিজেই দেয়
# ঐচ্ছিক: Speed Guard-এর জন্য Google PageSpeed API key (না দিলেও চলে, তবে দৈনিক সীমা কম)
PAGESPEED_API_KEY=""

# ---- ইমেইল পাঠানো (Email Marketing, Back in Stock, EU Withdrawal) ----
# ফাঁকা রাখলে কোনো ইমেইল যায় না (বার্তাগুলো "skipped" হিসেবে লেখা থাকে, পরে নিজে থেকে যায় না); অ্যাপের বাকি সব কাজ চলে।
# EMAIL_PROVIDER: "resend" বা "ses"। EMAIL_FROM: প্রোভাইডারে যাচাই করা নিজের ডোমেইনের ঠিকানা।
EMAIL_PROVIDER=""
EMAIL_FROM=""
# Resend বেছে নিলে। webhook secret দিয়ে bounce, অভিযোগ আর পৌঁছানোর খবর আসে:
# Resend-এ webhook-এর ঠিকানা দিন <অ্যাপের URL>/webhooks/email/resend
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Amazon SES বেছে নিলে। bounce আর অভিযোগের খবরের জন্য SES > SNS topic > <অ্যাপের URL>/webhooks/email/ses,
# আর সেই topic-এর ARN নিচে (অন্য কোনো topic-এর বার্তা নেওয়া হয় না)।
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_REGION=""
SES_CONFIGURATION_SET=""
SES_SNS_TOPIC_ARN=""

# ---- AI টুল (AI Studio: বর্ণনা, alt, FAQ, পোস্ট, প্ল্যান, পেজ, প্রোডাক্ট আনা, পেজ অডিট) ----
# ফাঁকা রাখলে AI টুলগুলো "এখন পাওয়া যাচ্ছে না" দেখায়; অ্যাপের বাকি সব কাজ চলে।
# চাবি পাবেন console.anthropic.com থেকে। খরচ প্রতিটা স্টোরের মাসিক ক্রেডিট দিয়ে বাঁধা (app/lib/plans.ts),
# সীমা পার হলে AI থেমে যায়, তাই কোনো স্টোরের খরচ সীমার বেশি হয় না।
ANTHROPIC_API_KEY=""
# ঐচ্ছিক: কোন মডেল চলবে। ফাঁকা থাকলে বড় লেখায় (বর্ণনা, প্ল্যান, অডিট, পেজ) claude-opus-5-5,
# আর ছোট ও বেশি সংখ্যার কাজে (alt, FAQ, পোস্ট) claude-haiku-5-5।
AI_MODEL=""
AI_FAST_MODEL=""

# ---- ছবি ও ভিডিওর AI টুল (Background Remover, Image Enhancer, Photoshoots, Image to Video, Video Ads) ----
# এগুলো fal.ai-এর মডেল দিয়ে চলে। fal.ai-তে অ্যাকাউন্ট খুলে কিছু ক্রেডিট কিনুন, তারপর
# fal.ai/dashboard/keys থেকে চাবি নিন। ফাঁকা রাখলে এই পাঁচটা টুল "এখন পাওয়া যাচ্ছে না" দেখায়।
# খরচ একই মাসিক AI ক্রেডিট থেকে কাটে (জমা দেওয়ার আগেই ধরে রাখা হয়), তাই সীমার বেশি কখনো খরচ হয় না।
# ফলের ফাইল আমাদের স্টোরেজে ৩০ দিন থাকে: প্রোডাকশনে নিচের R2 লাগবে (লোকালে .data/objects ফোল্ডার)।
# Video Ads-এর বিজ্ঞাপনের লেখার জন্য উপরের ANTHROPIC_API_KEY-ও লাগে।
FAL_KEY=""
# ঐচ্ছিক: ভিডিওর মডেল। kling (ডিফল্ট, ৫ বা ১০ সেকেন্ড, ভালো মান) বা ltx (৬ বা ১০ সেকেন্ড, সস্তা)।
AI_VIDEO_MODEL=""

# ---- গোপন তথ্যের এনক্রিপশন (Klaviyo, Mailchimp, Omnisend-এর API key আর Push-এর চাবি ডাটাবেসে এনক্রিপ্ট হয়ে থাকে;
#      ইমেইলের আনসাবস্ক্রাইব লিংকও এই চাবি দিয়ে সই করা) ----
# লোকাল ডেভেলপমেন্টে ফাঁকা রাখা যায় (তখন SHOPIFY_API_SECRET থেকে চাবি বানানো হয়)।
# প্রোডাকশনে অবশ্যই দিন, আর কখনো বদলাবেন না: বদলালে সেভ করা চাবিগুলো আর পড়া যাবে না,
# আর আগে পাঠানো ইমেইলের আনসাবস্ক্রাইব লিংক কাজ করবে না।
# বানানোর কমান্ড: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ---- Visitor Recordings আর ছবি ও ভিডিওর AI ফলের স্টোরেজ (Cloudflare R2) ----
# ফাঁকা রাখলে: লোকাল ডেভেলপমেন্টে রেকর্ড প্রজেক্টের .data/objects ফোল্ডারে থাকে (GitHub-এ যায় না),
# আর প্রোডাকশনে কোনো রেকর্ড হয় না (অ্যাডমিন সেটা বলে); অ্যাপের বাকি সব কাজ চলে।
# Cloudflare > R2 > bucket বানান, তারপর "Manage R2 API Tokens"-এ Object Read & Write চাবি নিন।
# নিরাপত্তার জন্য bucket-এ একটা lifecycle নিয়ম দিন: ৩৫ দিনের পুরনো ফাইল মুছে ফেলা
# (অ্যাপ নিজেই ৩০ দিনে মোছে; নিয়মটা শুধু বাড়তি সুরক্ষা)।
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# ঐচ্ছিক: অন্য S3-সমতুল্য সার্ভিস (যেমন MinIO) ব্যবহার করলে তার ঠিকানা
R2_ENDPOINT=""
