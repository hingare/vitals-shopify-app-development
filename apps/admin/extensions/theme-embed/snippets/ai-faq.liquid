{%- comment -%}
  AI Product FAQ: প্রোডাক্টের প্রশ্ন-উত্তর (মার্চেন্ট AI Studio-তে দেখে বসিয়েছেন)। সার্ভারেই লেখা, তাই
  ক্রলাররাও পড়ে; সব লেখা escape করা। faqSchema চালু থাকলে Google আর AI সার্চের জন্য FAQPage schema।
  প্যারামিটার: faq = product.metafields["$app"].ai_faq.value, s = টুলের সেটিংস।
{%- endcomment -%}
{%- if faq and faq.items.size > 0 -%}
  <div
    class="ats ats-faq app-ai-faq"
    data-app-ai-faq
    style="--ats-pad:12px;--ats-fg:{{ s.colors.text }};--ats-bg:{{ s.colors.background }};"
  >
    {%- if s.heading != blank -%}
      <h2 class="ats__h" style="text-align:start;font-size:1.3rem">{{ s.heading | escape }}</h2>
    {%- endif -%}
    <div class="ats-faq__list" style="max-width:none">
      {%- for item in faq.items limit: 8 -%}
        <details class="ats-faq__item">
          <summary>{{ item.question | escape }}</summary>
          <div>{{ item.answer | escape | newline_to_br }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.faqSchema -%}
    <script type="application/ld+json" data-app-schema>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for item in faq.items limit: 8 -%}
            {
              "@type": "Question",
              "name": {{ item.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | json }} }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}
