{% comment %}
  থিম সেকশন: Featured collection। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-collection ats-collection--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
<ul class="ats-grid ats-cards" style="--ats-cols:{{ s.columns }}">
{%- if s.collection != blank -%}
  {%- for p in s.collection.products limit: s.limit -%}
  <li class="ats-card">
  <a href="{{ p.url }}" class="ats-card__link">
    <div class="ats-card__media">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: p.featured_image.alt | default: p.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ats__ph' }}{%- endif -%}</div>
    <span class="ats-card__title">{{ p.title | escape }}</span>
  </a>
  <span class="ats-card__price">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif -%}{{ p.price | money }}</span>
</li>
  {%- endfor -%}
{%- else -%}
  {%- for i in (1..4) -%}<li class="ats-card">{{ 'product-1' | placeholder_svg_tag: 'ats__ph' }}<span class="ats-card__title">Product</span></li>{%- endfor -%}
{%- endif -%}
</ul>
{%- if s.collection != blank and s.view_all -%}<a class="ats__btn ats__btn--ghost" href="{{ s.collection.url }}">{{ s.view_all_label | escape }}</a>{%- endif -%}
</div>
</div>

{% schema %}
{"name": "Featured collection", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [{"value": "grid", "label": "Grid"}, {"value": "scroll", "label": "Swipe row"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Featured products"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4},
    {"type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4},
    {"type": "checkbox", "id": "view_all", "label": "Show \"View all\" link", "default": true},
    {"type": "text", "id": "view_all_label", "label": "\"View all\" text", "default": "View all"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
