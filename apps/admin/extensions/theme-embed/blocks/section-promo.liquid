{% comment %}
  থিম সেকশন: Promo banner। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-promo ats-promo--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
<div class="ats-promo__text">{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
{{ s.text }}</div>
{%- if s.code != blank -%}<p class="ats-promo__code">{{ s.code_label | escape }} <strong>{{ s.code | escape }}</strong></p>{%- endif -%}
{%- if s.button_label != blank -%}<a class="ats__btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>{%- endif -%}
</div>
</div>

{% schema %}
{"name": "Promo banner", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "bar", "options": [{"value": "bar", "label": "Slim bar"}, {"value": "card", "label": "Large card"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Free shipping this week"},
    {"type": "richtext", "id": "text", "label": "Text"},
    {"type": "text", "id": "code", "label": "Discount code (must exist in Shopify)"},
    {"type": "text", "id": "code_label", "label": "Text before the code", "default": "Use code"},
    {"type": "text", "id": "button_label", "label": "Button text", "default": "Shop now"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
