{% comment %}
  থিম সেকশন: Logo list। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-logos ats-logos--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
<div class="ats-logos__track">
{%- for pass in (1..2) -%}
  {%- if pass == 2 and s.layout != 'marquee' -%}{%- break -%}{%- endif -%}
  <ul class="ats-logos__list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
  {%- for i in (1..6) -%}
    {%- capture l %}logo_{{ i }}{% endcapture -%}
    {%- if s[l] != blank -%}<li>{{ s[l] | image_url: height: 120 | image_tag: loading: 'lazy', height: 60, class: 'ats-logos__img' }}</li>{%- elsif i < 5 and request.design_mode -%}<li>{{ 'logo' | placeholder_svg_tag: 'ats-logos__img ats__ph' }}</li>{%- endif -%}
  {%- endfor -%}
  </ul>
{%- endfor -%}
</div>
</div>
</div>

{% schema %}
{"name": "Logo list", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [{"value": "grid", "label": "Row of logos"}, {"value": "marquee", "label": "Moving logos"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": "As seen in"},
    {"type": "image_picker", "id": "logo_1", "label": "Logo 1"},
    {"type": "image_picker", "id": "logo_2", "label": "Logo 2"},
    {"type": "image_picker", "id": "logo_3", "label": "Logo 3"},
    {"type": "image_picker", "id": "logo_4", "label": "Logo 4"},
    {"type": "image_picker", "id": "logo_5", "label": "Logo 5"},
    {"type": "image_picker", "id": "logo_6", "label": "Logo 6"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
