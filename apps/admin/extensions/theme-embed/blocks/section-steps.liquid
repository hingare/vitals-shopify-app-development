{% comment %}
  থিম সেকশন: How it works। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-steps ats-steps--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
<ol class="ats-grid ats-steps__list">
{%- for i in (1..4) -%}
  {%- capture t %}title_{{ i }}{% endcapture -%}{%- capture d %}text_{{ i }}{% endcapture -%}
  {%- if s[t] != blank -%}<li class="ats-steps__item"><h3>{{ s[t] | escape }}</h3>{%- if s[d] != blank -%}<p>{{ s[d] | escape }}</p>{%- endif -%}</li>{%- endif -%}
{%- endfor -%}
</ol>
</div>
</div>

{% schema %}
{"name": "How it works", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "horizontal", "options": [{"value": "horizontal", "label": "Side by side"}, {"value": "vertical", "label": "One under another"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": "How it works"},
    {"type": "text", "id": "title_1", "label": "Step 1 title", "default": "Choose"},
    {"type": "text", "id": "text_1", "label": "Step 1 text", "default": "Pick the product you love."},
    {"type": "text", "id": "title_2", "label": "Step 2 title", "default": "Order"},
    {"type": "text", "id": "text_2", "label": "Step 2 text", "default": "Check out in a few clicks."},
    {"type": "text", "id": "title_3", "label": "Step 3 title", "default": "Enjoy"},
    {"type": "text", "id": "text_3", "label": "Step 3 text", "default": "We deliver to your door."},
    {"type": "text", "id": "title_4", "label": "Step 4 title"},
    {"type": "text", "id": "text_4", "label": "Step 4 text"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
