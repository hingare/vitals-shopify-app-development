{% comment %}
  থিম সেকশন: Hero banner। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-hero ats-hero--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in" style="--ats-overlay:{{ s.overlay | divided_by: 100.0 }}">
<div class="ats-hero__media">{%- if s.image != blank -%}{{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 800, 1200, 1600', sizes: '100vw', class: 'ats__img' }}{%- else -%}{{ 'hero-apparel-1' | placeholder_svg_tag: 'ats__img ats__ph' }}{%- endif -%}</div>
<div class="ats-hero__text">
{%- if s.eyebrow != blank -%}<p class="ats__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
{{ s.text }}
{%- if s.button_label != blank -%}<a class="ats__btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>{%- endif -%}
</div>
</div>
</div>

{% schema %}
{"name": "Hero banner", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "center", "options": [{"value": "center", "label": "Text over image, centered"}, {"value": "left", "label": "Text over image, left"}, {"value": "split", "label": "Image and text side by side"}]},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "eyebrow", "label": "Small text above heading"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Your headline here"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers what makes your store special.</p>"},
    {"type": "text", "id": "button_label", "label": "Button text", "default": "Shop now"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "range", "id": "overlay", "label": "Image darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
