{% comment %}
  থিম সেকশন: Image with text। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-image-text ats-image-text--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
<div class="ats-it__media">{%- if s.image != blank -%}{{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 800, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', class: 'ats__img' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'ats__img ats__ph' }}{%- endif -%}</div>
<div class="ats-it__text">{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
{{ s.text }}
{%- if s.button_label != blank -%}<a class="ats__btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>{%- endif -%}
</div>
</div>
</div>

{% schema %}
{"name": "Image with text", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "image_left", "options": [{"value": "image_left", "label": "Image left"}, {"value": "image_right", "label": "Image right"}, {"value": "overlap", "label": "Text card over image"}]},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Image with text"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Pair a picture with a short story about your product or brand.</p>"},
    {"type": "text", "id": "button_label", "label": "Button text", "default": "Learn more"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
