{% comment %}
  থিম সেকশন: Collection list। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-collections ats-collections--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
<ul class="ats-grid ats-cols__list">
{%- for c in s.collections -%}
  <li><a href="{{ c.url }}" class="ats-cols__item">
    <span class="ats-cols__media">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', sizes: '(min-width: 990px) 20vw, 45vw', alt: c.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'ats__ph' }}{%- endif -%}</span>
    <span>{{ c.title | escape }}</span>
  </a></li>
{%- else -%}
  {%- for i in (1..3) -%}<li class="ats-cols__item"><span class="ats-cols__media">{{ 'collection-1' | placeholder_svg_tag: 'ats__ph' }}</span><span>Collection</span></li>{%- endfor -%}
{%- endfor -%}
</ul>
</div>
</div>

{% schema %}
{"name": "Collection list", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [{"value": "grid", "label": "Square tiles"}, {"value": "circles", "label": "Round images"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Shop by category"},
    {"type": "collection_list", "id": "collections", "label": "Collections", "limit": 8},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
