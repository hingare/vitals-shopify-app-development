{% comment %}
  একটি মাত্র app embed সব টুল চালায়।
  চালু টুলের কনফিগ app-owned metafield (app_config.tools) থেকে আসে, তাই কোনো API কল লাগে না।
  লোডার ৫KB-র কম, আর শুধু চালু টুলগুলোর ফাইল আলাদাভাবে লোড করে।
{% endcomment %}
{%- assign app_config = app.metafields.app_config.tools.value -%}
{%- if app_config and app_config.tools.size > 0 -%}
  {%- comment -%}
    Best Sellers Protection: কেউ ?sort_by=best-selling লিংকে এলে সাধারণ ক্রমে পাঠানো হয়।
    এটা এখানে (লোডারের আগে) থাকে যাতে তালিকাটা যত কম সময় সম্ভব চোখে পড়ে; থিম পেজ নতুন করে লোড না
    করে ক্রম বদলালে উইজেট এই একই ফাংশন (window.__APP_BSP__) ডাকে।
    মার্চেন্ট নিজে কালেকশনের মূল ক্রম best-selling রাখলে কিছু করা হয় না।

    অনন্ত ঘোরাঘুরি ঠেকানো: কিছু থিমে এমন কোড থাকে যা সাধারণ পেজ খুললেই best-selling-এ পাঠায়; সেখানে
    আমরা ফেরত পাঠালে পেজ থামত না। তাই sessionStorage-এ ("app-bsp") মনে রাখা হয় শেষ কখন পাঠানো হলো আর
    এই ট্যাবে মোট কতবার। পাঠানোর ৩০ সেকেন্ডের মধ্যে একই পেজের সাধারণ ঠিকানা থেকে (document.referrer)
    আবার best-selling-এ আসা হলে সেটা থিমের কাজ ধরে নেওয়া হয়; তখন, বা এই ট্যাবে ৩ বার পাঠানো হয়ে গেলে,
    মান "off" হয় আর এই ট্যাবে আর পাঠানো হয় না। sessionStorage বন্ধ থাকলে পাঠানোই হয় না।
    নতুন পেজ আসা পর্যন্ত তালিকা আড়ালে থাকে; ৫ সেকেন্ডেও না এলে পেজ আবার দেখা যায়।
    (স্ক্রিপ্টের ভেতরে মন্তব্য রাখা হয়নি, কারণ সেগুলো ক্রেতার ব্রাউজারে যেত।)
  {%- endcomment -%}
  {%- if request.page_type == 'collection' and collection.default_sort_by != 'best-selling' -%}
    {%- for tool in app_config.tools -%}
      {%- if tool.id == 'best-sellers-protection' and tool.settings.redirectVisits -%}
        <script id="app-bsp">
          (function () {
            var KEY = 'app-bsp';
            var sent = false;
            function sorted(url) {
              return url.searchParams.getAll('sort_by').indexOf('best-selling') >= 0;
            }
            function go() {
              var url = new URL(location.href);
              if (sent || !sorted(url)) return;
              try {
                var saved = (sessionStorage.getItem(KEY) || '').split(' ');
                if (saved[0] === 'off') return;
                var last = Number(saved[0]) || 0;
                var total = Number(saved[1]) || 0;
                var from = document.referrer ? new URL(document.referrer) : null;
                var bounced =
                  last > 0 &&
                  Date.now() - last < 30000 &&
                  from !== null &&
                  from.origin + from.pathname === url.origin + url.pathname &&
                  !sorted(from);
                if (bounced || total >= 3) {
                  sessionStorage.setItem(KEY, 'off');
                  return;
                }
                sessionStorage.setItem(KEY, Date.now() + ' ' + (total + 1));
              } catch (e) {
                return;
              }
              sent = true;
              url.searchParams.delete('sort_by');
              url.searchParams.delete('page');
              var root = document.documentElement;
              root.style.visibility = 'hidden';
              setTimeout(function () {
                root.style.visibility = '';
                sent = false;
              }, 5000);
              location.replace(url.toString());
            }
            window.__APP_BSP__ = go;
            go();
          })();
        </script>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  <script>
    window.__APP_CONFIG__ = {
      assetBase: {{ 'loader.js' | asset_url | split: 'loader.js' | first | json }},
      pageType: {{ request.page_type | json }},
      locale: {{ request.locale.iso_code | json }},
      currency: {{ cart.currency.iso_code | json }},
      tzOffset: {{ 'now' | date: '%z' | json }},
      shopCurrency: {{ shop.currency | json }},
      moneyFormat: {{ shop.money_format | strip_html | json }},
      marketsCurrencies: {{ shop.enabled_currencies.size | json }},
      customerId: {{ customer.id | json }},
      country: {{ localization.country.iso_code | json }},
      defaultSort: {{ collection.default_sort_by | json }},
      countries: [
        {%- for tool in app_config.tools -%}
          {%- if tool.id == 'geolocation-redirect' -%}
            {%- for c in localization.available_countries -%}
              {{ c.iso_code | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      tools: {{ app_config.tools | json }},
      placement: {{ app_config.placement | json }},
      offers: {{ app.metafields.app_config.offers.value | json }}
    };
  </script>
  {%- if request.page_type == 'product' -%}
    {%- assign variant = product.selected_or_first_available_variant -%}
    <script type="application/json" id="app-product-json">
      {
        "productId": {{ product.id | json }},
        "handle": {{ product.handle | json }},
        "tags": {{ product.tags | json }},
        "createdAt": {{ product.created_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "compareAtCents": {{ variant.compare_at_price | default: 0 | json }},
        "title": {{ product.title | json }},
        "variantId": {{ variant.id | json }},
        "price": {{ variant.price | money | strip_html | json }},
        "priceCents": {{ variant.price | json }},
        "available": {{ variant.available | json }},
        "inventory": {
          {%- assign first = true -%}
          {%- for v in product.variants -%}
            {%- if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' -%}
              {%- unless first -%},{%- endunless -%}"{{ v.id }}": {{ v.inventory_quantity | json }}
              {%- assign first = false -%}
            {%- endif -%}
          {%- endfor -%}
        },
        {%- comment -%} Pre-Orders: স্টক শেষ কিন্তু "স্টক না থাকলেও বিক্রি" চালু এমন ভ্যারিয়েন্ট {%- endcomment -%}
        "preorder": [
          {%- assign first = true -%}
          {%- for v in product.variants -%}
            {%- if v.inventory_management == 'shopify' and v.inventory_policy == 'continue' and v.inventory_quantity <= 0 -%}
              {%- unless first -%},{%- endunless -%}{{ v.id | json }}
              {%- assign first = false -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
    {%- comment -%} রিভিউ চালু থাকলে Google-এর জন্য রেটিং (Shopify-র reviews.* metafield থেকে) {%- endcomment -%}
    {%- assign reviews_on = false -%}
    {%- for tool in app_config.tools -%}
      {%- if tool.id == 'product-reviews' -%}{%- assign reviews_on = true -%}{%- endif -%}
    {%- endfor -%}
    {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
    {%- if reviews_on and rating_count > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "name": {{ product.title | json }},
          "url": {{ request.origin | append: product.url | json }},
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
            "bestRating": 5,
            "worstRating": 1,
            "reviewCount": {{ rating_count | json }}
          }
        }
      </script>
    {%- endif -%}
  {%- endif -%}
  {%- comment -%} পেমেন্ট লোগো: Shopify নিজেই স্টোরে চালু পেমেন্টের লোগো দেয় {%- endcomment -%}
  {%- for tool in app_config.tools -%}
    {%- if tool.id == 'payment-logos' -%}
      <template id="app-payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      </template>
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%} দ্রুত চেকআউট বাটন লুকানো: পেজ আঁকার আগেই, যাতে এক মুহূর্তের জন্যও না দেখায় {%- endcomment -%}
  {%- for tool in app_config.tools -%}
    {%- if tool.id == 'hide-dynamic-checkout' -%}
      <style>
        {%- if tool.settings.hideOnProduct and request.page_type == 'product' -%}
          .shopify-payment-button{display:none!important}
        {%- endif -%}
        {%- if tool.settings.hideOnCart -%}
          .additional-checkout-buttons,[data-shopify="dynamic-checkout-cart"]{display:none!important}
        {%- endif -%}
      </style>
    {%- endif -%}
  {%- endfor -%}
  <script src="{{ 'loader.js' | asset_url }}" type="module" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:name",
  "target": "body",
  "settings": []
}
{% endschema %}
