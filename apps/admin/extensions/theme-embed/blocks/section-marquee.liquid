{% comment %}
  থিম সেকশন: Scrolling text। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-marquee ats-marquee--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in" style="--ats-speed:{{ s.speed }}s">
<p class="ats-vh">{{ s.text | escape }}</p>
<div class="ats-mq__track">
{%- for pass in (1..2) -%}<p class="ats-mq__row" aria-hidden="true">{% for x in (1..4) %}<span>{{ s.text | escape }}</span>{% endfor %}</p>{%- endfor -%}
</div>
</div>
</div>

{% schema %}
{"name": "Scrolling text", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "plain", "options": [{"value": "plain", "label": "Filled text"}, {"value": "outlined", "label": "Outlined big text"}]},
    {"type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders"},
    {"type": "range", "id": "speed", "label": "Seconds for one loop", "min": 10, "max": 60, "step": 5, "default": 30},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
