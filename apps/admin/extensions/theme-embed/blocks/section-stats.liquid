{% comment %}
  থিম সেকশন: Numbers। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-stats ats-stats--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
<ul class="ats-grid ats-stats__list">
{%- for i in (1..4) -%}
  {%- capture v %}value_{{ i }}{% endcapture -%}{%- capture l %}label_{{ i }}{% endcapture -%}
  {%- if s[v] != blank -%}<li class="ats-stats__item"><strong>{{ s[v] | escape }}</strong><span>{{ s[l] | escape }}</span></li>{%- endif -%}
{%- endfor -%}
</ul>
</div>
</div>

{% schema %}
{"name": "Numbers", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "row", "options": [{"value": "row", "label": "Simple row"}, {"value": "cards", "label": "Cards"}]},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "text", "id": "value_1", "label": "Number 1", "default": "10,000+"},
    {"type": "text", "id": "label_1", "label": "Label 1", "default": "Happy customers"},
    {"type": "text", "id": "value_2", "label": "Number 2", "default": "4.9/5"},
    {"type": "text", "id": "label_2", "label": "Label 2", "default": "Average rating"},
    {"type": "text", "id": "value_3", "label": "Number 3"},
    {"type": "text", "id": "label_3", "label": "Label 3"},
    {"type": "text", "id": "value_4", "label": "Number 4"},
    {"type": "text", "id": "label_4", "label": "Label 4"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
