{% comment %}
  থিম সেকশন: Image gallery। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-gallery ats-gallery--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
<ul class="ats-grid ats-gal__list">
{%- for i in (1..6) -%}
  {%- capture g %}image_{{ i }}{% endcapture -%}
  {%- if s[g] != blank -%}<li>{{ s[g] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 33vw, 50vw' }}</li>
  {%- elsif i < 4 and request.design_mode -%}<li>{{ 'lifestyle-1' | placeholder_svg_tag: 'ats__ph' }}</li>{%- endif -%}
{%- endfor -%}
</ul>
</div>
</div>

{% schema %}
{"name": "Image gallery", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [{"value": "grid", "label": "Even grid"}, {"value": "mosaic", "label": "Mosaic (first image large)"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": ""},
    {"type": "image_picker", "id": "image_1", "label": "Image 1"},
    {"type": "image_picker", "id": "image_2", "label": "Image 2"},
    {"type": "image_picker", "id": "image_3", "label": "Image 3"},
    {"type": "image_picker", "id": "image_4", "label": "Image 4"},
    {"type": "image_picker", "id": "image_5", "label": "Image 5"},
    {"type": "image_picker", "id": "image_6", "label": "Image 6"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
