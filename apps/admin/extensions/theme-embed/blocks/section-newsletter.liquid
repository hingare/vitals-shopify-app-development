{% comment %}
  থিম সেকশন: Newsletter signup। শুধু Liquid + CSS, কোনো JavaScript নেই (দোকান দ্রুত থাকে)।
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
<div class="ats ats-newsletter ats-newsletter--{{ s.layout }}{% if s.full %} ats--full{% endif %}" style="--ats-pad:{{ s.pad }}px;{% if s.bg != blank %}--ats-bg:{{ s.bg }};{% endif %}{% if s.fg != blank %}--ats-fg:{{ s.fg }};{% endif %}{% if s.accent != blank %}--ats-accent:{{ s.accent }};{% endif %}" {{ block.shopify_attributes }}>
<div class="ats__in">
<div class="ats-nl__text">{%- if s.heading != blank -%}<h2 class="ats__h">{{ s.heading | escape }}</h2>{%- endif -%}
{{ s.text }}</div>
{%- form 'customer', id: block.id, class: 'ats-nl__form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  {%- if form.posted_successfully? -%}
  <p class="ats-nl__ok" role="status">{{ s.success | escape }}</p>
  {%- else -%}
  <label class="ats-vh" for="{{ block.id }}-email">Email</label>
  <input id="{{ block.id }}-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.placeholder | escape }}">
  <button type="submit" class="ats__btn">{{ s.button_label | escape }}</button>
  {%- if form.errors -%}<p class="ats-nl__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
  {%- endif -%}
{%- endform -%}
</div>
</div>

{% schema %}
{"name": "Newsletter signup", "target": "section", "stylesheet": "sections.css",
  "settings": [
    {"type": "select", "id": "layout", "label": "Layout", "default": "inline", "options": [{"value": "inline", "label": "Text and field side by side"}, {"value": "boxed", "label": "Centered box"}]},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Join our newsletter"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Get news about new products and offers.</p>"},
    {"type": "text", "id": "placeholder", "label": "Field hint", "default": "Your email"},
    {"type": "text", "id": "button_label", "label": "Button text", "default": "Subscribe"},
    {"type": "text", "id": "success", "label": "Thank-you message", "default": "Thanks for subscribing!"},
    {"type": "header", "content": "Style"},
    {"type": "color", "id": "bg", "label": "Background"},
    {"type": "color", "id": "fg", "label": "Text color"},
    {"type": "color", "id": "accent", "label": "Button color"},
    {"type": "range", "id": "pad", "label": "Space above and below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "full", "label": "Full width", "default": false}
  ]
}
{% endschema %}
