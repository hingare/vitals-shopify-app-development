// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// একটি ইনস্টল করা স্টোর
model Shop {
  id               String              @id @default(cuid())
  domain           String              @unique
  /// "starter" | "professional" | null (কোনো প্ল্যান নেই)
  plan             String?
  /// Shopify-র subscription id, যাতে প্ল্যান বদলালে মেলানো যায়
  subscriptionId   String?
  installedAt      DateTime            @default(now())
  uninstalledAt    DateTime?
  /// Web Pixel ইভেন্ট পাঠানোর গোপন নয় এমন চাবি (কোন স্টোরের ইভেন্ট তা চেনার জন্য)
  ingestKey        String?             @unique
  /// Shopify-তে তৈরি web pixel-এর id ও যে URL-এ সে ইভেন্ট পাঠায়
  pixelId          String?
  pixelEndpoint    String?
  /// সব অফারের জন্য আমাদের একটাই automatic app discount (Shopify gid)
  offersDiscountId String?
  /// অফারের স্টোর-জুড়ে সেটিংস, যেমন কনফ্লিক্ট নিয়ম (app/lib/offers.server.ts)
  offerSettings    Json?
  /// থিমে উইজেট কোথায় বসবে, মার্চেন্ট নিজে ঠিক করলে (app/lib/placement.ts)
  placement        Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tools            ToolSetting[]
  speedSnapshots   SpeedSnapshot[]
  speedJobs        SpeedJob[]
  dailyStats       DailyToolStat[]
  storeStats       DailyStoreStat[]
  trafficStats     DailyTrafficStat[]
  pageStats        DailyPageStat[]
  visitorDays      VisitorDay[]
  reviews          Review[]
  offers           Offer[]
  recentSales      RecentSale[]
  offerStats       OfferDailyStat[]
  abStats          DailyAbStat[]
  /// Web pixel-এ সর্বশেষ পাঠানো সেটিংস (বদলালে আবার পাঠানো হয়)
  pixelSettings    String?
  /// Web Push-এর VAPID চাবি (private অংশ এনক্রিপ্ট করা)
  vapidPublicKey   String?
  vapidPrivateKey  String?
  /// ইমেইলের প্রেরকের নাম, reply-to, ঠিকানা (app/lib/email-settings.ts)
  emailSettings    Json?
  integrations     Integration[]
  subscribers      Subscriber[]
  messages         Message[]
  emailCampaigns   EmailCampaign[]
  emailFlows       EmailFlow[]
  checkouts        AbandonedCheckout[]
  stockAlerts      StockAlert[]
  wheelSpins       WheelSpin[]
  wishlistItems    WishlistItem[]
  pushSubscribers  PushSubscription[]
  pushCampaigns    PushCampaign[]
  withdrawals      WithdrawalRequest[]
  altTextChanges   AltTextChange[]
  jobs             Job[]
}

/// প্রতিটি স্টোরে প্রতিটি টুলের অবস্থা ও সেটিংস
model ToolSetting {
  id        String   @id @default(cuid())
  shopId    String
  toolId    String
  enabled   Boolean  @default(false)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, toolId])
}

/// Speed Guard: মোবাইল স্পিড স্কোরের ইতিহাস
model SpeedSnapshot {
  id           String   @id @default(cuid())
  shopId       String
  url          String
  /// "baseline" = কোনো টুল চালুর আগে, "check" = পরে
  kind         String
  score        Int
  lcpMs        Int?
  cls          Float?
  tbtMs        Int?
  enabledTools Int      @default(0)
  createdAt    DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// অ্যানালিটিক্স: প্রতিদিন প্রতিটি টুলের ভিউ, ক্লিক, কার্টে যোগ ও বিক্রি
model DailyToolStat {
  id         String   @id @default(cuid())
  shopId     String
  toolId     String
  /// UTC দিন
  date       DateTime @db.Date
  views      Int      @default(0)
  clicks     Int      @default(0)
  addToCarts Int      @default(0)
  orders     Int      @default(0)
  /// স্টোরের মুদ্রায়
  revenue    Decimal  @default(0) @db.Decimal(14, 2)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, toolId, date])
}

/// Speed Guard মাপ ব্যাকগ্রাউন্ডে চলে (PageSpeed এক মিনিটের বেশি নিতে পারে)
model SpeedJob {
  id         String    @id @default(cuid())
  shopId     String
  url        String
  /// "pending" | "running" | "done" | "failed"
  status     String    @default("pending")
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([shopId, createdAt])
}

/// পুরো স্টোরের দৈনিক হিসাব (Web Pixel থেকে)
model DailyStoreStat {
  id           String   @id @default(cuid())
  shopId       String
  date         DateTime @db.Date
  /// দিনে আলাদা ভিজিটর
  visitors     Int      @default(0)
  pageViews    Int      @default(0)
  productViews Int      @default(0)
  addToCarts   Int      @default(0)
  checkouts    Int      @default(0)
  orders       Int      @default(0)
  revenue      Decimal  @default(0) @db.Decimal(14, 2)
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
}

/// ভিজিটর কোথা থেকে এলো আর কোন ডিভাইসে
model DailyTrafficStat {
  id       String   @id @default(cuid())
  shopId   String
  date     DateTime @db.Date
  /// direct | search | social | ai | email | paid | referral
  source   String
  /// mobile | tablet | desktop
  device   String
  visitors Int      @default(0)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date, source, device])
}

/// কোন পেজ কতবার দেখা হলো
model DailyPageStat {
  id     String   @id @default(cuid())
  shopId String
  date   DateTime @db.Date
  path   String
  views  Int      @default(0)
  shop   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date, path])
}

/// দিনে আলাদা ভিজিটর গোনার জন্য (clientId-এর hash, কোনো ব্যক্তিগত তথ্য নয়); ২ দিন পর মুছে ফেলা হয়
model VisitorDay {
  shopId  String
  date    DateTime @db.Date
  visitor String
  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, date, visitor])
}

/// ক্রেতার রিভিউ। productId null মানে স্টোর রিভিউ (কোনো প্রোডাক্টের নয়)
model Review {
  id          String        @id @default(cuid())
  shopId      String
  /// Shopify প্রোডাক্টের সংখ্যা-id (gid ছাড়া)
  productId   String?
  /// ১ থেকে ৫
  rating      Int
  title       String?
  body        String
  authorName  String
  /// শুধু মার্চেন্ট দেখেন; স্টোরে কখনো দেখানো হয় না; GDPR redact এলে মুছে যায়
  authorEmail String?
  /// অর্ডার থেকে নিশ্চিত ক্রেতা
  verified    Boolean       @default(false)
  /// pending | published | rejected
  status      String        @default("pending")
  /// form | import | request | manual
  source      String        @default("form")
  /// মার্চেন্টের উত্তর (স্টোরে রিভিউর নিচে দেখায়)
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  media       ReviewMedia[]

  @@index([shopId, productId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, authorEmail])
}

/// রিভিউর ছবি। ফাইল মার্চেন্টের Shopify Files-এ থাকে (আমাদের সার্ভারে নয়), তাই স্টোরেজ খরচ নেই
model ReviewMedia {
  id        String   @id @default(cuid())
  reviewId  String
  /// Shopify-র MediaImage gid
  fileId    String
  /// Shopify ছবি প্রসেস শেষ করলে CDN URL আসে; তার আগে null
  url       String?
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

/// Volume Discount বা Bundle অফার। চেকআউটে একটাই Shopify discount function সব অফার চালায়
model Offer {
  id        String   @id @default(cuid())
  shopId    String
  /// volume | bundle
  type      String
  /// শুধু মার্চেন্টের জন্য নাম
  name      String
  active    Boolean  @default(true)
  /// টাইপ অনুযায়ী সেটিংস (offers.server.ts-এর zod schema দিয়ে যাচাই করা)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, type])
}

/// Recent Sales Notifications-এর জন্য সাম্প্রতিক বিক্রি। শুধু প্রোডাক্ট আর সময়, ক্রেতার কোনো তথ্য নয়।
model RecentSale {
  id        String   @id @default(cuid())
  shopId    String
  productId String
  title     String
  handle    String
  imageUrl  String?
  soldAt    DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, soldAt])
}

/// প্রতিদিন প্রতিটি অফারের অর্ডার, সেই অর্ডারগুলোর মোট বিক্রি আর দেওয়া ছাড় (orders/paid webhook থেকে)
model OfferDailyStat {
  id       String   @id @default(cuid())
  shopId   String
  offerId  String
  /// UTC দিন
  date     DateTime @db.Date
  orders   Int      @default(0)
  /// অর্ডারের মোট দাম, স্টোরের মুদ্রায়
  revenue  Decimal  @default(0) @db.Decimal(14, 2)
  /// এই অফারে দেওয়া মোট ছাড়
  discount Decimal  @default(0) @db.Decimal(14, 2)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, offerId, date])
}

/// A/B টেস্ট: প্রতিদিন প্রতিটি গ্রুপের অর্ডার ও বিক্রি (AOV তুলনার জন্য)
model DailyAbStat {
  id      String   @id @default(cuid())
  shopId  String
  /// "A" বা "B"
  group   String
  date    DateTime @db.Date
  orders  Int      @default(0)
  revenue Decimal  @default(0) @db.Decimal(14, 2)
  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, group, date])
}

/// বাইরের সার্ভিসের সংযোগ (Klaviyo, Mailchimp, Omnisend)।
/// চাবি AES-256-GCM-এ এনক্রিপ্ট করা থাকে; স্টোরফ্রন্টে কখনো যায় না
model Integration {
  id         String    @id @default(cuid())
  shopId     String
  /// klaviyo | mailchimp | omnisend
  provider   String
  /// এনক্রিপ্ট করা JSON (app/lib/crypto.server.ts)
  secret     String
  /// গোপন নয় এমন সেটিংস: কোন টুলের গ্রাহক কোন লিস্টে যাবে, sender id ইত্যাদি
  config     Json      @default("{}")
  /// connected | error
  status     String    @default("connected")
  lastError  String?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider])
}

/// মার্কেটিং ইমেইলের গ্রাহক। সম্মতির আসল উৎস Shopify-র customer; এটা তার দ্রুত কপি
model Subscriber {
  id             String    @id @default(cuid())
  shopId         String
  /// ছোট হাতের অক্ষরে
  email          String
  phone          String?
  firstName      String?
  /// subscribed | unsubscribed | bounced | complained
  status         String    @default("subscribed")
  /// shopify | popup | spin-wheel | back-in-stock | review
  source         String    @default("shopify")
  /// Shopify customer-এর সংখ্যা-id (জানা থাকলে)
  customerId     String?
  consentAt      DateTime  @default(now())
  unsubscribedAt DateTime?
  lastOrderAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@index([shopId, status, createdAt])
  @@index([shopId, customerId])
}

/// পাঠানো বার্তা (ইমেইল): লাইনে থাকা থেকে পৌঁছানো পর্যন্ত অবস্থা
model Message {
  id          String    @id @default(cuid())
  shopId      String
  /// এখন শুধু email (পরে অন্য মাধ্যম যোগ হলে এখানেই আলাদা হবে)
  channel     String
  /// campaign | flow | back-in-stock | withdrawal | test
  kind        String
  /// ক্যাম্পেইনের id বা flow-র নাম
  refId       String?
  /// ইমেইল ঠিকানা
  recipient   String
  /// একই বার্তা দুবার না পাঠাতে (যেমন "campaign:<id>:<email>")
  dedupeKey   String?
  /// বার্তা বানানোর তথ্য (subject, heading, body, button)
  payload     Json
  /// queued | sending | sent | delivered | failed | bounced | complained | skipped
  status      String    @default("queued")
  error       String?
  attempts    Int       @default(0)
  /// প্রোভাইডারের দেওয়া id (delivery webhook মেলাতে)
  providerId  String?
  sendAt      DateTime  @default(now())
  /// পাঠানোর জন্য কখন তুলে নেওয়া হয়েছে (সার্ভার বন্ধ হলে আটকে থাকা বার্তা চিনতে)
  lockedAt    DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime  @default(now())
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dedupeKey])
  @@index([status, sendAt])
  @@index([shopId, channel, createdAt])
  @@index([shopId, kind, refId])
  @@index([shopId, recipient])
  @@index([providerId])
}

/// একবারের ইমেইল ক্যাম্পেইন
model EmailCampaign {
  id          String    @id @default(cuid())
  shopId      String
  /// শুধু মার্চেন্টের জন্য নাম
  name        String
  /// subject, heading, body, button (app/lib/email-template.ts-এর schema)
  content     Json
  /// draft | scheduled | sending | sent
  status      String    @default("draft")
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status, scheduledAt])
}

/// স্বয়ংক্রিয় ইমেইল (flow)। key: welcome | abandoned-checkout | review-request | winback
model EmailFlow {
  id           String   @id @default(cuid())
  shopId       String
  key          String
  enabled      Boolean  @default(false)
  /// ঘটনার কত মিনিট পরে পাঠাবে
  delayMinutes Int
  content      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
}

/// অসম্পূর্ণ চেকআউট (abandoned checkout ইমেইলের জন্য)। অর্ডার হলে চিহ্ন পড়ে; ৩০ দিন পরে মুছে যায়
model AbandonedCheckout {
  id               String    @id @default(cuid())
  shopId           String
  token            String
  email            String
  firstName        String?
  /// ক্রেতাকে চেকআউটে ফেরানোর লিংক (Shopify-র দেওয়া)
  recoveryUrl      String
  total            Decimal   @db.Decimal(14, 2)
  currency         String
  /// ক্রেতা মার্কেটিং ইমেইলে রাজি কিনা
  acceptsMarketing Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, token])
  @@index([shopId, email])
  @@index([createdAt])
}

/// Back in Stock: স্টকে ফিরলে জানানোর অনুরোধ
model StockAlert {
  id         String    @id @default(cuid())
  shopId     String
  productId  String
  variantId  String
  email      String
  /// waiting | notified
  status     String    @default("waiting")
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, variantId, email])
  @@index([shopId, variantId, status])
  @@index([shopId, email])
}

/// Spin the Wheel: কে কখন ঘুরিয়েছে আর কী পেয়েছে
model WheelSpin {
  id        String    @id @default(cuid())
  shopId    String
  email     String
  /// কোন ঘরে থেমেছে (০ থেকে)
  slice     Int
  label     String
  /// জেতা ডিসকাউন্ট কোড (না জিতলে null)
  code      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, email, createdAt])
}

/// Wishlist। owner = "c:<customer id>" (লগইন করা ক্রেতা) বা "g:<র‍্যান্ডম id>" (অতিথি)
model WishlistItem {
  id        String   @id @default(cuid())
  shopId    String
  owner     String
  productId String
  handle    String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, owner, productId])
  @@index([shopId, productId])
}

/// Web Push-এর গ্রাহক (ব্রাউজারের দেওয়া ঠিকানা ও চাবি; কোনো ব্যক্তিগত তথ্য নয়)
model PushSubscription {
  id        String   @id @default(cuid())
  shopId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, endpoint])
}

/// পাঠানো push নোটিফিকেশন
model PushCampaign {
  id        String   @id @default(cuid())
  shopId    String
  title     String
  body      String
  url       String
  /// queued | sending | sent
  status    String   @default("queued")
  sent      Int      @default(0)
  failed    Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// EU Withdrawal Button: চুক্তি প্রত্যাহারের অনুরোধ
model WithdrawalRequest {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  email       String
  orderNumber String
  details     String   @default("")
  /// new | handled
  status      String   @default("new")
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([shopId, email])
}

/// SEO Alt Tags: বদলানো alt লেখার আগের মান (আগের অবস্থায় ফেরানোর জন্য)
model AltTextChange {
  id        String   @id @default(cuid())
  shopId    String
  /// Shopify MediaImage gid
  mediaId   String
  productId String
  oldAlt    String
  newAlt    String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, mediaId])
}

/// সাধারণ ব্যাকগ্রাউন্ড কাজ (ক্যাম্পেইন পাঠানো, alt লেখা, সিঙ্ক)
model Job {
  id         String    @id @default(cuid())
  shopId     String
  kind       String
  payload    Json      @default("{}")
  /// pending | running | done | failed
  status     String    @default("pending")
  error      String?
  attempts   Int       @default(0)
  /// অগ্রগতি দেখানোর জন্য, যেমন {"done": 40, "total": 120}
  progress   Json?
  runAt      DateTime  @default(now())
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([shopId, kind, createdAt])
}
