{
  "name": "allinone-shopify-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @app/widgets build && pnpm --filter @app/admin dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "size": "pnpm --filter @app/widgets size",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "deploy": "pnpm --filter @app/widgets build && pnpm --filter @app/admin deploy"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "rrweb-snapshot": "2.2.0",
      "rrdom": "2.2.0",
      "@rrweb/types": "2.2.0",
      "@rrweb/utils": "2.2.0",
      "rrweb": "2.2.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
